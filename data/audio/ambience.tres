[sub_resource type="Resource" id="Resource_4a5ff"]
script = ExtResource("2_ffwpp")
layer_id = &"wind_low"
enters_at = 0.09
gain_db = -14.0
pitch_scale = 0.97
pitch_at_full = 1.02
notes = "The body of the air. Silent below 0.09, which is 97.6% of a still night and 22.3% of a valley day."

[sub_resource type="Resource" id="Resource_wrkrd"]
script = ExtResource("2_ffwpp")
layer_id = &"wind_mid"
enters_at = 0.26
full_at = 0.52
pitch_scale = 0.98
pitch_at_full = 1.05
withdraws_near_danger = true
notes = "The gust. Enters just under wind_valley's own gust_threshold of 0.30, so it arrives with the event."

[sub_resource type="Resource" id="Resource_0m576"]
script = ExtResource("2_ffwpp")
layer_id = &"wind_high"
enters_at = 0.55
full_at = 0.88
gain_db = -15.0
pitch_at_full = 1.09
withdraws_near_danger = true
notes = "The squall's top. 5.4% of a valley day, 46.3% of a gale."

[sub_resource type="Resource" id="Resource_2p8l6"]
script = ExtResource("2_ffwpp")
layer_id = &"snow_fall"
source = 1
enters_at = 0.16
full_at = 0.62
gain_db = -17.0
pitch_at_full = 1.06
withdraws_near_danger = true
notes = "Falling snow, driven by Snowfall.snowfall_rate() rather than by the wind."

[resource]
