[ext_resource type="Script" uid="uid://camq77b4qewpu" path="res://src/definitions/accessibility_setting.gd" id="1_setting"]
[ext_resource type="Script" uid="uid://cv0yx54e0lljg" path="res://src/definitions/accessibility_catalog.gd" id="2_catalog"]

[sub_resource type="Resource" id="Setting_prompt_hold"]
script = ExtResource("1_setting")
id = &"prompt_hold"
label = "提示停留时长"
minimum = 0.5
maximum = 3.0
default_value = 1.0

[sub_resource type="Resource" id="Setting_stroke_bold"]
script = ExtResource("1_setting")
id = &"stroke_bold"
label = "提示笔画加粗"
is_toggle = true
step = 1.0

[sub_resource type="Resource" id="Setting_screen_shake"]
script = ExtResource("1_setting")
id = &"screen_shake"
label = "屏 幕 震 动"
is_toggle = true
step = 1.0
default_value = 1.0

[resource]
script = ExtResource("2_catalog")
entries = Array[ExtResource("1_setting")]([SubResource("Setting_prompt_hold"), SubResource("Setting_stroke_bold"), SubResource("Setting_screen_shake")])
