# Godot 4+ specific ignores
.godot/
/android/

# Local source art, imported binaries, and visual reference material. These are
# intentionally kept outside Git because several individual files exceed the
# hosting service's 100 MB object limit. Build/source code and data definitions
# remain versioned; contributors acquire the asset pack separately.
/assets/
/Refs/
/Unarmed_RM.glb
/Unarmed_RM.glb.import

# Subagent-driven-development scratch: ledgers, briefs, reports, review packages
.superpowers/

# Third-party asset packs unzipped into the project root. Source material, not
# source code: we import what we need out of them and the originals stay local.
#
# These also carry a .gdignore so Godot stops trying to import them -- the sound
# pack was printing eight "Not a WAV file" errors on every single --import.
/Sound FX Starter Pack Vol. 1/
/Unarmed/
/__MACOSX/
/RPG-Character*
/RPG Animations GLB FREE Version Changes.txt
