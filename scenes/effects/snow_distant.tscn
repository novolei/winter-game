[gd_scene load_steps=2 format=3]

; STYLE DOCUMENT SECTION 21 -- the far snow: the texture of the air rather than
; anything the player watches. Every number is set here rather than left to the
; script's defaults so the three layers can be read side by side, which is how
; the six lighting presets are authored and for the same reason.
;
; THE BOX IS A VOLUME OF AIR, NOT A VIEWPORT. It holds a fixed number of flakes
; at a fixed density and it does NOT move when the camera does: a tighter frame
; sweeps a smaller cross-section of the same field and simply catches fewer of
; them. That is what makes "you are seeing more of the same snowstorm" literally
; true, and it is the only arrangement under which the storm does not appear to
; ease off when the player scrolls a wheel.
;
; So it is sized for the WIDEST frame the camera offers -- `authored_frame` below
; -- rather than for the tightest, and it grows further only if some later stop
; outgrows it. 58.3 x 35.6 x 58.3 is the old 36 x 22 x 36 at that frame.
;
; The count is the old 1200 scaled by the box's CROSS-SECTION, not its volume:
; what the picture catches is density times frame area times the depth of field
; the slab passes through, and the depth grew too. Scaling by volume was tried
; first and measured 65% too much snow at the tight framing. 2477 measures the
; tight framing at 1126 units of ink against the 1057 it had before any of this,
; and the three stops at 100 / 95.8 / 101.1 -- against 100 / 76.7 / 62.8 before.
;
; The document asks for 1000-1800 flakes in a 60 x 25 x 60 box; this is a larger
; box than that now, and the density is what was preserved rather than the count.
;
; pullback_m was 25.9, which put the bottom of the birth box at y = 1.51 -- above
; world zero, but still 1.5 m below the highest snow surface SnowField can
; produce (terrain_amplitude_m 2.4 + max_depth_m 0.6 = 3.0), so over a crest the
; far snow was being born inside the hill. 28.1 lifts the bottom to 3.07 m, and
; the whole of that is spent on the PULLBACK rather than on a height because
; sliding a volume along the view axis of a parallel projection does not move it
; on screen. See the longer note in snow_near.tscn, which had the same defect
; four times as deep.

[ext_resource type="Script" path="res://src/rendering/snowfall_layer.gd" id="1_layer"]

[node name="SnowDistant" type="GPUParticles3D"]
script = ExtResource("1_layer")
camera_space = false
volume_size = Vector3(58.3, 35.6, 58.3)
authored_frame = Vector2(27.2, 17)
pullback_m = 28.1
flakes_clear = 186
flakes_blizzard = 2477
life_seconds = 11.0
flake_size_min = 0.035
flake_size_max = 0.055
fall_speed_clear = 0.9
fall_speed_blizzard = 2.1
fall_accel = 0.2
drift_clear = Vector3(0.25, 0, 0.08)
drift_blizzard = Vector3(1.15, 0, 0.35)
randomness_clear = 0.35
randomness_blizzard = 0.55
spread_degrees = 32.0
flake_whiteness = 0.55
flake_alpha = 0.62
